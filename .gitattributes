# Keep shell scripts LF-only regardless of the checkout platform's core.autocrlf,
# since a CRLF shebang line breaks exec on Linux/macOS ("bad interpreter").
*.sh text eol=lf
*.sh.tmpl text eol=lf
run_once_* text eol=lf

# PowerShell scripts are fine as CRLF (and some tooling expects it on Windows).
*.ps1 text eol=crlf
*.ps1.tmpl text eol=crlf
