#!/bin/sh
# One-time setup for a fresh machine: Oh My Zsh + Starship, both skipped
# silently if already installed. Safe to re-run (chezmoi only runs this
# once per machine anyway, tracked by content hash).

{{- if eq .profile "christian" }}
if [ ! -d "$HOME/.oh-my-zsh" ] && command -v zsh >/dev/null 2>&1; then
    echo "Installing Oh My Zsh..."
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended < /dev/null
fi
{{- end }}
{{- /* hermes profile is pared-down: no zsh/Oh My Zsh, Starship-only prompt */}}

if ! command -v starship >/dev/null 2>&1; then
    echo "Installing Starship..."
    # IMPORTANT: --bin-dir "$HOME/.local/bin", not the installer's default
    # of /usr/local/bin. The default triggers the installer's elevate_priv()
    # -> `sudo -v`, which HANGS FOREVER over a non-interactive Ansible
    # connection with no controlling TTY (no password prompt ever arrives,
    # and -v doesn't fail fast even with NOPASSWD sudo configured for the
    # account). Installing to the user's own writable ~/.local/bin avoids
    # sudo entirely. ~/.local/bin is already on PATH via Debian's default
    # ~/.profile (added by adduser's /etc/skel) on every target host.
    mkdir -p "$HOME/.local/bin"
    # Explicitly close stdin (</dev/null): under a non-interactive Ansible
    # `command` invocation (no pty, no explicit stdin redirect), the
    # installer's own `read` calls can block forever waiting for input
    # that will never arrive, even with --yes passed. Observed hang:
    # the installed sh process sits at 0% CPU indefinitely.
    curl -sS https://starship.rs/install.sh | sh -s -- --yes --bin-dir "$HOME/.local/bin" < /dev/null
fi
